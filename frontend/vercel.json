{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://project-infranox.onrender.com/api/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "https://project-infranox.onrender.com/static/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
